<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>InfoHubLite</RootNamespace>
    <AssemblyName>InfoHubLite.Settings</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>..\assets\InfoHubLite.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WinUI 3, unpackaged (a plain exe, no MSIX), carrying its own copy of the Windows App SDK runtime. -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Own folder: the UI's dependency set must not mix with the engine's. The engine launches Settings\InfoHubLite.Settings.exe. -->
    <OutputPath>..\dist\Settings\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- The pieces of the Windows App SDK that WinUI needs; the full metapackage also drags in AI/ML/Search/Widgets (~45 MB). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Window / taskbar icon and the title-bar mark, loaded from beside the exe. -->
    <Content Include="..\assets\InfoHubLite.ico;..\assets\logo-256.png" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- One copy of the config contract, media format and panel constants, shared with the engine. -->
    <Compile Include="..\Engine\Config.cs;..\Engine\Media.cs;..\Engine\Lcd.cs;..\Engine\Templates.cs;..\Engine\Renderer.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
